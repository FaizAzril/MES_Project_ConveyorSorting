# Copy this file to .env (same folder as main.py).
# Exact Realtime Database URL from Firebase Console > Realtime Database > Data.
FIREBASE_DATABASE_URL=PASTE_YOUR_REALTIME_DATABASE_URL_HERE

# Service-account key: Firebase Console > Project settings > Service accounts >
# Generate new private key. Keep it private; it is ignored by git.
FIREBASE_CREDENTIALS=serviceAccountKey.json
